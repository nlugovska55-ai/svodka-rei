{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "inbox": false,
      "outbox": false
    }
  },
  "functions": {
    "api/tg.js": {
      "includeFiles": "data/svodka.json",
      "maxDuration": 60
    }
  }
}
